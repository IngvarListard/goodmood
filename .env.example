# Локальная конфигурация goodmood. Скопируй в .env и заполни.
# В контейнере/на NAS переменные задаются через compose env_file — .env там не используется.

# Секрет подписи cookie-сессий (обязателен)
GOODMOOD_SESSION_SECRET=change-me-to-a-long-random-string

# Первый запуск на пустой БД: креды админа (seed)
GOODMOOD_ADMIN_EMAIL=admin@goodmood.local
GOODMOOD_ADMIN_PASSWORD=change-me

# AI-функции (OpenRouter). Без ключа AI-секции просто не показываются.
OPENROUTER_API_KEY=

# Порт и путь к БД (дефолты: 3000, resources/goodmood.db)
#GOODMOOD_PORT=3000
#GOODMOOD_DB_PATH=resources/goodmood.db
