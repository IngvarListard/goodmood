{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}
        metosin/reitit {:mvn/version "0.10.1"}
        metosin/malli {:mvn/version "0.20.1"}
        metosin/muuntaja {:mvn/version "0.6.11"}
        integrant/integrant {:mvn/version "1.0.1"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
        migratus/migratus {:mvn/version "1.6.7"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        tongue/tongue {:mvn/version "0.4.4"}
        ring/ring-anti-forgery {:mvn/version "1.4.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        clj-http/clj-http {:mvn/version "3.13.1"}
        ;; Web Push (VAPID + aes128gcm); BouncyCastle берёт из classpath
        ;; (bcprov-jdk18on через buddy), собственная 15on помечена optional
        nl.martijndwars/web-push {:mvn/version "5.1.2"}
        com.lambdaisland/dotenv {:mvn/version "0.2.5"}}

 :aliases {:run {:main-opts ["-m" "app.core"]}
           ;; Dev-старт: nREPL (:7890) + приложение (:3000) в одном процессе.
           ;; Правки view/route-неймспейсов подхватываются (require ... :reload)
           ;; по nREPL без рестарта процесса. Инлайн -e вместо отдельного
           ;; dev-неймспейса: новые .clj-файлы на этой машине (JDK 25 + btrfs)
           ;; перестают видеться classloader'ом спустя ~минуту после создания.
           :dev {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
                 :main-opts ["-e" "(do (require 'nrepl.server) (nrepl.server/start-server :port 7890 :bind \"127.0.0.1\") (println \"nREPL on 7890\"))"
                             "-m" "app.core"]}
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
                   :main-opts ["-m" "nrepl.cmdline"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                   :ns-default build}
            ;; В test/ только тесты — грузим все *_test.clj из каталога test/
            ;; (запуск из корня репо) и прогоняем автоматически, без списка ns.
            :test {:extra-paths ["test"]
                   :main-opts ["-e" "(require 'clojure.java.io 'clojure.string 'clojure.test)(doseq [f (sort (file-seq (clojure.java.io/file \"test\"))) :when (and (.isFile f) (clojure.string/ends-with? (.getName f) \"_test.clj\"))] (load-file (str f)))(clojure.test/run-all-tests)"]}}}
